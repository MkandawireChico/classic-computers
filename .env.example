# ==================================================================
# Classic Computers LLC platform — environment variables
# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored and must NEVER be committed.
# ==================================================================

# --- Supabase (browser-safe) --------------------------------------
# Safe to expose to the browser: the anon key is designed for public
# client use and is constrained entirely by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only, NEVER expose to the browser) ----------
# Bypasses RLS. Only ever read in server-side code (Route Handlers,
# Server Actions, Server Components). Never reference this in any
# file that ships to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- App -------------------------------------------------------------
# Public site origin, used for generating absolute URLs (sitemap,
# canonical tags, Open Graph). Browser-safe.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Future integrations (not used in Phase 1) ----------------------
# Left here as placeholders so the shape of future config is visible.
# Do not fill these in until the corresponding provider is actually
# integrated — an unused key in .env.local is harmless, but nothing
# in the codebase should read these yet.
# PAYMENT_PROVIDER_API_KEY=
# WHATSAPP_BUSINESS_API_TOKEN=
# EMAIL_PROVIDER_API_KEY=
